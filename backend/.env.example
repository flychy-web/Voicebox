PORT=3001
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# OpenAI (Whisper transcription)
OPENAI_API_KEY=sk-...

# Anthropic (Claude summarization)
ANTHROPIC_API_KEY=sk-ant-...

# Secret for signing login tokens and hashing PINs. Required in production:
# at least 32 random characters, e.g. the output of `openssl rand -hex 32`.
# Changing it signs everyone out and invalidates existing PINs.
# In development, leaving it unset generates one in DATA_DIR/.dev-auth-secret.
AUTH_SECRET=

# Days a login stays valid before the app asks for the PIN again (default 30)
TOKEN_TTL_DAYS=30

# Number of reverse proxy hops in front of the app (1 on Railway). Leave unset
# when the app is reachable directly, or clients could spoof their IP.
# TRUST_PROXY=1

# Data directory (audio files + SQLite DB)
DATA_DIR=./data
